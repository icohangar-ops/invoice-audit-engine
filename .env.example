# Precoro API key: Configuration -> Integrations -> API Key
PRECORO_TOKEN=
# Email of the user who generated the key (required as a second auth header)
PRECORO_EMAIL=
# CHP human-lock policy for finding actions (auditengine.chp_gate).
# Unset: hold-grade findings (severity high) require a named confirmer.
# 1 = every action requires a confirmer; 0 = never required.
INVOICE_AUDIT_CHP_REQUIRE_HUMAN_LOCK=
